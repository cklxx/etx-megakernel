static __device__ __forceinline__ void etx_call_body(int sym, const etx_ctx* ctx) {
  switch (sym) {
    case 0: vl_prologue(ctx); break;
    case 1: etx_tile_rep_rms_norm_2d(ctx); break;
    case 2: etx_tile_x_dsl_gemv(ctx); break;
    case 3: etx_tile_dsl_attnprep(ctx); break;
    case 4: etx_tile_attn_mfma16_g8(ctx); break;
    case 5: etx_tile_attn_reduce(ctx); break;
    case 6: etx_tile_dsl_gemv(ctx); break;
    case 7: etx_tile_dsl_gemv_router_fold(ctx); break;
    case 8: etx_tile_rep_dsl_topk(ctx); break;
    case 9: etx_tile_x_dsl_moe_up_fold(ctx); break;
    case 10: etx_tile_x_dsl_moe_down_fold(ctx); break;
    case 11: etx_tile_dsl_gemv_fold(ctx); break;
    case 12: vl_argmax(ctx); break;
    default: break;
  }
}

