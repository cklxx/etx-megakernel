#ifndef ETX_MIN_WG_PER_CU   // the plan's residency (P1). NOTE: launch_bounds' second argument is MIN
// WAVES PER EU, not workgroups per CU, and for this persistent kernel (one 16-wave workgroup per CU by
// construction) it cannot raise occupancy at all -- it only caps VGPRs and forces spills. Round 34: =8 gave
// VGPR 64 / 1678 spills / runtime occupancy still 4.000 / 9.39 wall against 4.88. Leave it at the default.
#define ETX_MIN_WG_PER_CU 1
#endif
#if ETX_MIN_WG_PER_CU > 0
extern "C" __global__ void __launch_bounds__(ETX_THREADS, ETX_MIN_WG_PER_CU) etx_megakernel_d0(etx_params p) {
#else
extern "C" __global__ void __launch_bounds__(ETX_THREADS) etx_megakernel_d0(etx_params p) {
#endif
  // Logical worker id = domain * workers_per_domain + slot, where the slot is claimed at start.
  // This makes the static queues domain-affine under ANY workgroup->domain mapping (measured (k+6) mod 8 on one VM).
  __shared__ uint32_t s_domain, s_worker; __shared__ int32_t s_tid, s_slot;
#ifdef ETX_HAS_IMPORTS
  etx_import_init();   // imported tiles' slot barriers (etx/import.h); ordered by the barrier below
#endif
  if (threadIdx.x == 0) {
    const uint32_t d = etx_discover_domain(p, blockIdx.x);
#ifdef ETX_SLOT_BY_CU
    // pair workgroups by CU: the k-th workgroup to arrive on the i-th CU of the domain takes slot k * cus + i, so
    // slot w and slot w + cus share a CU (two requests interleaved one per workgroup; docs/PLAN-v3.md 4.4)
    int32_t* cu_count = p.domain_slots + ETX_NUM_DOMAINS;   // layout: etx/host.h ETX_SLOT_WORDS
    int32_t* cu_k = cu_count + ETX_NUM_DOMAINS;
    int32_t* cu_map = cu_k + ETX_NUM_DOMAINS * 256;
    const uint32_t key = etx_amdgcn_cu_key();
    int32_t* mapped = cu_map + d * 256 + key;
    int32_t idx = -1;
    if (atomicCAS(mapped, -1, -2) == -1) { idx = atomicAdd(cu_count + d, 1); __hip_atomic_store(mapped, idx, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT); }
    else { while ((idx = __hip_atomic_load(mapped, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT)) < 0) {} }
    const int32_t k = atomicAdd(cu_k + d * 256 + key, 1);
    const int32_t slot = (idx < ETX_CUS_PER_DOMAIN && k < 1) ? k * ETX_CUS_PER_DOMAIN + idx : 0x7FFFFFFF;
#else
    const int32_t slot = atomicAdd(p.domain_slots + d, 1);
#endif
    s_domain = d; s_slot = slot; s_worker = (slot < p.workers_per_domain) ? d * p.workers_per_domain + slot : 0xFFFFFFFFu;
  }
  __syncthreads();
  const uint32_t domain = s_domain, worker = s_worker;
  int32_t cursor = 0, cend = 0;
  if (worker != 0xFFFFFFFFu) { cursor = p.static_begin[worker]; cend = p.static_end[worker]; }   // surplus workers only serve queues
  // every task on this device is static: no readiness probe, no queue pops -- take the head and
  // wait on it (the probe was one more poller of the same word and one more round trip per task)
  __shared__ etx_task s_task;
  for (;;) {
    if (threadIdx.x == 0) {
      if (cursor < cend) { s_tid = p.static_queue[cursor]; s_task = p.static_descs[cursor]; ++cursor; } else s_tid = -1;
    }
    __syncthreads();
    const int32_t tid = s_tid;
    if (tid < 0) break;
    const etx_task cur = s_task;
    if (p.trace_exec && threadIdx.x == 0) atomicAdd(p.trace_exec + tid, 1);
    etx_run_task(p, cur, worker, domain, tid);
    __syncthreads();
  }
}


