      // wait r0_E_oproj_0 via 'xw->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 43 + (idx), domain)
  ETX_TARGET(0);
