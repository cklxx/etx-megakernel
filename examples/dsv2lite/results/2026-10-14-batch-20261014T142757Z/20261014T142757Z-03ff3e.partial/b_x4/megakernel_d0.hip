static __device__ __forceinline__ void etx_run_task(const etx_params& p, const etx_task t, uint32_t worker, uint32_t domain, int32_t tid) {
  __shared__ __align__(16) unsigned char etx_lds[ETX_LDS_USED > 0 ? ETX_LDS_USED : 16];
  uint64_t* tr = p.trace_time ? p.trace_time + (size_t)tid * 4 : nullptr;
  if (tr && threadIdx.x == 0) tr[0] = (uint64_t)ETX_TIMER();
  etx_ctx ctx; for (int i = 0; i < 4; ++i) ctx.coord[i] = t.coord[i];
  ctx.shape = p.shape; ctx.args = p.type_args + t.type * p.max_args; ctx.events = p.events; ctx.ev_offset = p.ev_offset; ctx.ev_shape = (const int32_t*)p.ev_shape;
  ctx.domain = domain; ctx.worker = worker; ctx.lds = etx_lds; ctx.cst[0] = ctx.cst[1] = ctx.cst[2] = ctx.cst[3] = 0;
  int sym = -1;
  switch (t.type) {   // phase 1: immediates, waits, acquire
    case 0: { // r0_embed [static] grid=(1,)
      ctx.cst[0] = -1; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      sym = 0;   // fleet_embed
      break; }
    case 1: { // r1_embed [static] grid=(1,)
      ctx.cst[0] = -1; ctx.cst[1] = 1; ctx.cst[2] = 0; ctx.cst[3] = 0;
      sym = 0;   // fleet_embed
      break; }
    case 2: { // r2_embed [static] grid=(1,)
      ctx.cst[0] = -1; ctx.cst[1] = 2; ctx.cst[2] = 0; ctx.cst[3] = 0;
      sym = 0;   // fleet_embed
      break; }
    case 3: { // r3_embed [static] grid=(1,)
      ctx.cst[0] = -1; ctx.cst[1] = 3; ctx.cst[2] = 0; ctx.cst[3] = 0;
      sym = 0;   // fleet_embed
      break; }
    case 4: { // r0_qkv_0 [static] grid=(8, 37)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r0_E_embed via 'xw->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 0 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 1;   // fleet_qkv_fused_kvs
      break; }
    case 5: { // r0_qabs_0 [static] grid=(16, 2)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r0_E_qkv_0 via 'hs->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 4 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 2;   // fleet_q_absorb
      break; }
    case 6: { // r0_attn_0 [static] grid=(16, 16)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r0_E_qkv_0 via 'hc->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 4 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 3;   // fleet_attention_kvs
      break; }
    case 7: { // r0_merge_0 [static] grid=(16, 16)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      // wait r0_E_attn_0 via 'hc->h' (DOMAIN)
#define ETX_TARGET(idx) etx_wait_DOMAIN(p.events + ETX_EVW(21 + (idx)), p.ctrl_abort)
  ETX_TARGET(t.coord[0]);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 4;   // fleet_merge_uv
      break; }
    case 8: { // r0_oproj_0 [static] grid=(8, 37)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      // wait r0_E_merge_0 via 'xw->x' (DOMAIN)
#define ETX_TARGET(idx) etx_wait_DOMAIN(p.events + ETX_EVW(37 + (idx)), p.ctrl_abort)
  ETX_TARGET(t.coord[0]);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 5;   // fleet_o_proj
      break; }
    case 9: { // r0_norm_0 [static] grid=(8, 37)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r0_E_oproj_0 via 'xw->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 45 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 6;   // fleet_norm_router
      break; }
    case 10: { // r0_dense_gu_0 [static] grid=(8, 37)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      // wait r0_E_norm_0 via 'xw->x' (DOMAIN)
#define ETX_TARGET(idx) etx_wait_DOMAIN(p.events + ETX_EVW(46 + (idx)), p.ctrl_abort)
  ETX_TARGET(t.coord[0]);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 7;   // fleet_dense_gate_up
      break; }
    case 11: { // r0_dense_dn_0 [static] grid=(8, 37)
      ctx.cst[0] = 0; ctx.cst[1] = 0; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r0_E_dgu_0 via 'xw->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 54 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        if (etx_lok) ETX_ACQUIRE_DOMAIN(); else ETX_ACQUIRE_DEVICE();   // relay did the domain-level half
      }
      sym = 8;   // fleet_dense_down
      break; }
    case 12: { // r1_qkv_0 [static] grid=(8, 37)
      ctx.cst[0] = 0; ctx.cst[1] = 1; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r1_E_embed via 'xw->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 1 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 1;   // fleet_qkv_fused_kvs
      break; }
    case 13: { // r1_qabs_0 [static] grid=(16, 2)
      ctx.cst[0] = 0; ctx.cst[1] = 1; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r1_E_qkv_0 via 'hs->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 56 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 2;   // fleet_q_absorb
      break; }
    case 14: { // r1_attn_0 [static] grid=(16, 16)
      ctx.cst[0] = 0; ctx.cst[1] = 1; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      bool etx_lok = true;   // every relayed wait was covered by its domain relay's acquire
      // wait r1_E_qkv_0 via 'hc->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 56 + (idx), domain)
  ETX_TARGET(0);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 3;   // fleet_attention_kvs
      break; }
    case 15: { // r1_merge_0 [static] grid=(16, 16)
      ctx.cst[0] = 0; ctx.cst[1] = 1; ctx.cst[2] = 0; ctx.cst[3] = 0;
      if (threadIdx.x == 0) {
      // wait r1_E_attn_0 via 'hc->h' (DOMAIN)
#define ETX_TARGET(idx) etx_wait_DOMAIN(p.events + ETX_EVW(73 + (idx)), p.ctrl_abort)
  ETX_TARGET(t.coord[0]);
#undef ETX_TARGET
        // coherent-L1 tile: no acquire invalidate (payload loads are agent scope)
      }
      sym = 4;   // fleet_merge_uv
      break; }
    case 16: { // r1_oproj_0 [static] grid=(8, 37)
      ctx.cst[0] = 0; ctx.cst[1] = 1; ctx.cst[2] = 0; ctx.cst[3] = 0;
