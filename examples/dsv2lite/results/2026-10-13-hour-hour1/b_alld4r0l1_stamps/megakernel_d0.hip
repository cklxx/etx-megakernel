// single-TU build: tile sources included so the bodies can inline into the dispatch
#include "examples/dsv2lite/fleet_shim.hip"

static __device__ __forceinline__ void etx_call_body(int sym, const etx_ctx* ctx) {
  switch (sym) {
    case 0: fleet_embed(ctx); break;
    case 1: fleet_qkv_fused(ctx); break;
    case 2: fleet_q_absorb(ctx); break;
    case 3: fleet_attention(ctx); break;
    case 4: fleet_merge_uv(ctx); break;
    case 5: fleet_o_proj(ctx); break;
    case 6: fleet_norm_router(ctx); break;
    case 7: fleet_dense_gate_up(ctx); break;
    case 8: fleet_dense_down(ctx); break;
    case 9: fleet_d4_shared_gate_up(ctx); break;
    case 10: fleet_d4_routed_gate_up(ctx); break;
    case 11: fleet_d4_routed_down(ctx); break;
    case 12: fleet_d4_shared_down(ctx); break;
    case 13: fleet_qkv_fused_fold(ctx); break;
    case 14: fleet_lm_head_fold(ctx); break;
    case 15: fleet_argmax(ctx); break;
    default: break;
  }
}

