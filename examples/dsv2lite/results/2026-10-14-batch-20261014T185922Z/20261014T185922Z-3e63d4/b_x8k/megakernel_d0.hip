      // wait r0_E_qkv_0 via 'hs->(0)' (DEVICE, relay mirror)
#define ETX_TARGET(idx) etx_lok &= etx_wait_DEVICE_mirror(p, 8 + (idx), domain)
  ETX_TARGET(0);
